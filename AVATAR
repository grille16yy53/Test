local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local function collectSmallParts()
	local plotRoot = workspace:FindFirstChild("PIayerAircraft") -- capital I
	local plot = plotRoot and plotRoot:FindFirstChild(lp.Name)
	assert(plot, "[Scarab] plot not found")
	local list = {}
	for _, v in ipairs(plot:GetDescendants()) do
		if v.Name == "SmallPart" and v:IsA("Model") and v:FindFirstChild("SPart") then
			table.insert(list, { model = v, part = v.SPart, position = v.SPart.Position })
		end
	end
	table.sort(list, function(a, b)
		local ap, bp = a.position, b.position
		if math.abs(ap.Y - bp.Y) > 0.01 then return ap.Y < bp.Y end
		if math.abs(ap.Z - bp.Z) > 0.01 then return ap.Z > bp.Z end
		return ap.X < bp.X
	end)
	return plot, list
end

----------------------------------------------------------------------
-- MODE "build": paint + resize the SmallParts (run on the UNSPAWNED plot)
----------------------------------------------------------------------
local function build()
	local RS = game:GetService("ReplicatedStorage")
	local Remotes = RS:WaitForChild("Remotes")
	local UpdateValue = Remotes:WaitForChild("UpdateValue")
	local PAINT_BATCH, MAX_RETRIES, RETRY_DELAY, CALL_TIMEOUT = 31, 4, 0.15, 2
	local paintRemote
	for _, v in ipairs(Remotes:GetDescendants()) do
		if v.Name == "paintRemote" then paintRemote = v.Parent break end
	end
	assert(paintRemote, "[Scarab] paintRemote not found")

	local _, smallParts = collectSmallParts()
	local count = math.min(#BOXES, #smallParts)
	if #BOXES > #smallParts then
		warn(("Need %d SmallParts, plot has %d - %d boxes will be missing!"):format(#BOXES, #smallParts, #BOXES - #smallParts))
	end
	print(("[Scarab] found %d SmallParts, using %d"):format(#smallParts, count))
	assert(count > 0, "[Scarab] no SmallParts on the plot")

	local function callWithTimeout(fn)
		local done, ok, res = false, false, nil
		task.spawn(function() ok, res = pcall(fn) done = true end)
		local t = tick()
		while not done and tick() - t < CALL_TIMEOUT do task.wait() end
		if not done then return false end
		return ok, res
	end

	-- PAINT
	local paintFail, nextIndex = 0, 1
	while nextIndex <= count do
		local n = math.min(PAINT_BATCH, count - nextIndex + 1)
		local finished = 0
		for k = 0, n - 1 do
			local i = nextIndex + k
			task.spawn(function()
				local part, color = smallParts[i].part, BOXES[i].color
				local ok = part.Color == color
				if not ok then
					for _ = 1, MAX_RETRIES do
						local s, r = callWithTimeout(function() return paintRemote:InvokeServer(part, color, nil) end)
						if s and r then ok = true break end
						task.wait(RETRY_DELAY)
					end
				end
				if not ok then paintFail = paintFail + 1 end
				finished = finished + 1
			end)
		end
		while finished < n do task.wait() end
		nextIndex = nextIndex + n
		print(("[Scarab] painted %d/%d (%d failed)"):format(nextIndex - 1, count, paintFail))
	end

	-- SIZES
	local objs, finished = {}, 0
	for i = 1, count do
		local box, model = BOXES[i], smallParts[i].model
		task.spawn(function()
			local c = model:WaitForChild("Configuration", 3)
			local o = c and { c:WaitForChild("Size X", 3), c:WaitForChild("Size Y", 3), c:WaitForChild("Size Z", 3) }
			objs[i] = o
			if o then
				local v = { box.gx, box.gy, box.gz }
				for k = 1, 3 do
					if o[k] and math.abs((tonumber(o[k].Value) or -1) - v[k]) > 0.006 then
						pcall(function() UpdateValue:FireServer(v[k], o[k]) end)
					end
				end
			end
			finished = finished + 1
		end)
		if i % 100 == 0 then task.wait() end
	end
	while finished < count do task.wait(0.2) end
	local t0, best, stuck, miss = tick(), math.huge, 0, 0
	while tick() - t0 < 45 do
		task.wait(3)
		miss = 0
		for i = 1, count do
			local o, box = objs[i], BOXES[i]
			local want, ok = { box.gx, box.gy, box.gz }, o and o[1] and o[2] and o[3]
			if ok then
				for k = 1, 3 do
					if math.abs((tonumber(o[k].Value) or -1) - want[k]) > 0.006 then ok = false break end
				end
			end
			if not ok then miss = miss + 1 end
		end
		print(("[Scarab] sizes still missing: %d of %d"):format(miss, count))
		if miss == 0 then break end
		if miss < best then best = miss stuck = 0 else stuck = stuck + 1 end
		if stuck >= 4 then break end
	end
	print(("[Scarab] BUILD DONE (paint fails %d, size missing %d). Re-run if any are missing, then spawn the plane and set MODE = \"run\"."):format(paintFail, miss))
end

