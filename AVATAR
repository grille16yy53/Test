local function run()
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local plot, smallParts = collectSmallParts()
	if lp.Character == nil then lp.CharacterAdded:Wait() end

	-- map real parts -> boxes by (size,colour) key, ties broken by sorted order
	local queues = {}
	for i, b in ipairs(BOXES) do
		local q = queues[b.key]
		if not q then q = {} queues[b.key] = q end
		q[#q + 1] = b
	end
	local qi = {}
	local parts, boxOf = {}, {}
	for _, sp in ipairs(smallParts) do
		local c = sp.model:FindFirstChild("Configuration")
		local sx, sy, sz = c and c:FindFirstChild("Size X"), c and c:FindFirstChild("Size Y"), c and c:FindFirstChild("Size Z")
		if sx and sy and sz then
			local col = sp.part.Color
			local key = q100(sx.Value) .. "," .. q100(sy.Value) .. "," .. q100(sz.Value) .. "|"
				.. math.floor(col.R * 255 + 0.5) .. "," .. math.floor(col.G * 255 + 0.5) .. "," .. math.floor(col.B * 255 + 0.5)
			local q = queues[key]
			if q then
				qi[key] = (qi[key] or 0) + 1
				local b = q[qi[key]]
				if b then
					parts[#parts + 1] = sp.part
					boxOf[#parts] = b
					if ANCHOR then pcall(function() sp.part.Anchored = true end) end
				end
			end
		end
	end
	print(("[Scarab] mapped %d / %d parts"):format(#parts, #BOXES))
	assert(#parts > 0, "[Scarab] no parts matched - did you run MODE='build' first?")

	-- model-space skeleton (studs)
	local rest = {}
	for k, cf in pairs(REST) do rest[k] = scaledCF(cf) end
	local legs = {}
	local ORDER = { "rf", "lb", "lf", "rb" }
	local GROUP = { rf = 1, lb = 1, lf = 2, rb = 2 }
	for _, n in ipairs(ORDER) do
		local d = LEGS[n]
		local H, K, A = d.H * SCALE, d.K * SCALE, d.A * SCALE
		local ax0 = (A - H).Unit
		local kv = K - H
		local p0 = kv - ax0 * kv:Dot(ax0)
		legs[n] = {
			name = n, H = H, K = K, A = A, L1 = (K - H).Magnitude, L2 = (A - K).Magnitude,
			ax0 = ax0, p0 = p0.Unit, v0 = (A - K).Unit, u0 = (K - H).Unit,
			drop = d.drop * SCALE, restT = rest[n .. "T"], restS = rest[n .. "S"], group = GROUP[n],
			planted = Vector3.zero, stepping = false, t = 0, from = Vector3.zero, to = Vector3.zero,
		}
	end
	local BODY_LIFT = 24.9 * SCALE

	local function fromTo(a, b)
		local d = a:Dot(b)
		if d > 0.99999 then return CFrame.identity end
		if d < -0.99999 then
			local ax = a:Cross(Vector3.new(0, 1, 0))
			if ax.Magnitude < 1e-3 then ax = a:Cross(Vector3.new(1, 0, 0)) end
			return CFrame.fromAxisAngle(ax.Unit, PI)
		end
		return CFrame.fromAxisAngle(a:Cross(b).Unit, math.acos(math.clamp(d, -1, 1)))
	end

	-- two-bone IK, returns thigh CF and shin CF in model space
	local function solveLeg(L, E)
		local H = L.H
		local d = E - H
		local D = math.clamp(d.Magnitude, math.abs(L.L1 - L.L2) + 0.01, L.L1 + L.L2 - 0.001)
		local axN = d.Magnitude > 1e-4 and d.Unit or L.ax0
		local swing = fromTo(L.ax0, axN)
		local pole = swing:VectorToWorldSpace(L.p0)
		local a = (L.L1 ^ 2 - L.L2 ^ 2 + D ^ 2) / (2 * D)
		local h = math.sqrt(math.max(0, L.L1 ^ 2 - a ^ 2))
		local K = H + axN * a + pole * h
		local Eeff = H + axN * D
		local R1 = fromTo(L.u0, (K - H).Unit)
		local v0r = R1:VectorToWorldSpace(L.v0)
		local R2 = fromTo(v0r, (Eeff - K).Unit)
		local thigh = CFrame.new(H) * R1 * CFrame.new(-H) * L.restT
		local shin = CFrame.new(K) * R2 * R1 * CFrame.new(-L.K) * L.restS
		return thigh, shin
	end

	-- raycast ground
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local function refreshFilter()
		local f = { plot }
		if lp.Character then f[#f + 1] = lp.Character end
		rp.FilterDescendantsInstances = f
	end
	refreshFilter()
	local baseY
	local function groundAt(x, z, fromY)
		local r = workspace:Raycast(Vector3.new(x, fromY + 60, z), Vector3.new(0, -400, 0), rp)
		return r and r.Position.Y or baseY
	end

	-- start state
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local startPos = root and (root.Position + root.CFrame.LookVector * 40) or Vector3.new(0, 10, 0)
	baseY = startPos.Y - 3
	do
		local r = workspace:Raycast(startPos + Vector3.new(0, 80, 0), Vector3.new(0, -400, 0), rp)
		if r then baseY = r.Position.Y end
	end
	local yaw = root and math.atan2(root.CFrame.LookVector.X, -root.CFrame.LookVector.Z) or 0
	local pos = Vector3.new(startPos.X, baseY + BODY_LIFT, startPos.Z)
	local vel = Vector3.zero
	local bobT = 0

	local function basis(p, yw, pitch, roll)
		local fwd = Vector3.new(math.sin(yw), 0, -math.cos(yw))
		local up = Vector3.yAxis
		local left = up:Cross(fwd)
		local cf = CFrame.fromMatrix(p, left, up, fwd)
		return cf * CFrame.Angles(pitch, 0, roll)
	end
	local function restFoot(L, body)
		-- desired plant position (world) under the foot's rest location
		local w = body:PointToWorldSpace(Vector3.new(L.A.X, 0, L.A.Z))
		return Vector3.new(w.X, groundAt(w.X, w.Z, body.Position.Y), w.Z)
	end

	local body0 = basis(pos, yaw, 0, 0)
	for _, L in pairs(legs) do L.planted = restFoot(L, body0) end

	local conn
	local function cleanup()
		if conn then conn:Disconnect() conn = nil end
		ENV.ScarabRunning = false
	end
	ENV.ScarabStop = cleanup

	local moveF, turnV = 0, 0
	conn = RunService.Heartbeat:Connect(function(dt)
		dt = math.min(dt, 0.05)
		moveF = (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
		turnV = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
		local speed = SPEED * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 1.7 or 1)
		yaw = yaw + turnV * TURN_RATE * dt
		local fwd = Vector3.new(math.sin(yaw), 0, -math.cos(yaw))
		local targetVel = fwd * moveF * speed
		vel = vel:Lerp(targetVel, math.min(1, dt * 6))
		pos = pos + vel * dt

		-- body height from average planted ground, with a little bob while walking
		local gsum = 0
		for _, L in pairs(legs) do gsum = gsum + L.planted.Y end
		local gavg = gsum / 4
		local moving = vel.Magnitude > 0.5 or math.abs(turnV) > 0
		bobT = bobT + dt * (moving and 9 or 0)
		local bob = moving and math.sin(bobT) * 0.35 * SCALE * 10 or 0
		pos = Vector3.new(pos.X, pos.Y + ((gavg + BODY_LIFT + bob) - pos.Y) * math.min(1, dt * 8), pos.Z)
		local lean = math.clamp(-vel:Dot(fwd) / (speed + 1e-3), -1, 1) * 0.04
		local body = basis(pos, yaw, lean, 0)

		-- foot stepping
		local stepActive = { false, false, false }
		for _, L in pairs(legs) do if L.stepping then stepActive[L.group] = true end end
		for _, n in ipairs(ORDER) do
			local L = legs[n]
			if L.stepping then
				L.t = L.t + dt / STEP_TIME
				local t = math.min(L.t, 1)
				local p = L.from:Lerp(L.to, t)
				L.planted = p + Vector3.new(0, math.sin(t * PI) * STEP_H, 0)
				if t >= 1 then L.stepping = false L.planted = L.to end
			else
				local want = restFoot(L, body)
				local lead = Vector3.new(vel.X, 0, vel.Z) * STEP_TIME * 0.9
				local err = Vector3.new(want.X - L.planted.X, 0, want.Z - L.planted.Z)
				local other = (L.group == 1) and 2 or 1
				-- don't lift a leg while the opposite diagonal pair is mid-step
				if err.Magnitude > STEP_DIST and not stepActive[other] then
					L.stepping = true
					stepActive[L.group] = true
					L.t = 0
					L.from = L.planted
					local tgt = want + lead
					L.to = Vector3.new(tgt.X, groundAt(tgt.X, tgt.Z, body.Position.Y), tgt.Z)
				end
			end
		end

		-- IK -> bone frames (model space)
		local boneCF = { body = CFrame.identity }
		for n, L in pairs(legs) do
			local E = body:PointToObjectSpace(L.planted + Vector3.new(0, L.drop, 0))
			local th, sh = solveLeg(L, E)
			boneCF[n .. "T"], boneCF[n .. "S"] = th, sh
		end

		-- bone rest -> parts. boxes are stored relative to the bone REST frame
		local cfs = table.create(#parts)
		for i = 1, #parts do
			local b = boxOf[i]
			local bc = boneCF[b.bone]
			if b.bone == "body" then
				cfs[i] = body * rest.body * b.cf
			else
				cfs[i] = body * bc * b.cf
			end
		end
		local ok = pcall(function() workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged) end)
		if not ok then
			for i = 1, #parts do pcall(function() parts[i].CFrame = cfs[i] end) end
		end
	end)
	print("[Scarab] walking: W/S move, A/D turn, Shift sprint. Stop with getgenv().ScarabStop() (or _G.ScarabStop())")
end

----------------------------------------------------------------------
if ENV.ScarabRunning then warn("[Scarab] already running - call ScarabStop() or rejoin") return end
ENV.ScarabRunning = true
local ok, err = pcall(MODE == "build" and build or run)
if not ok then warn("[Scarab] " .. tostring(err)) end
if MODE == "build" or not ok then ENV.ScarabRunning = false end
