-- compatibility shims (works on weak executors too)
local ENV = (type(getgenv) == "function" and getgenv()) or _G
local task = task or { wait = wait, spawn = function(f, ...) return coroutine.wrap(f)(...) end, delay = delay }
local function safe(f, ...) local ok, e = pcall(f, ...) return ok, e end
local PI = math.pi
